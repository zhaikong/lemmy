{
  "name": "@mariozechner/lemmy-red-teaming-example",
  "version": "0.1.0",
  "description": "Red-teaming scenario example using lemmy - AI safety demonstration",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "lemmy-red-teaming": "./dist/index.js"
  },
  "scripts": {
    "dev": "node api.js && tsc --watch --pretty",
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "run": "node api.js && tsx src/index.ts",
    "start": "node api.js && node dist/index.js"
  },
  "dependencies": {
    "@mariozechner/lemmy": "file:../../packages/lemmy",
    "chalk": "^5.4.1"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "tsx": "^4.19.4",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
